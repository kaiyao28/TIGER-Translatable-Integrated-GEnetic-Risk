\name{TIGER-package}
\alias{TIGER}
\alias{TIGER-package}
\title{TIGER: Translatable Integrated Genetic Risk}
\description{
Transparent R functions for combining liability-scale polygenic risk,
separately modelled common high-impact variants, and rare-variant carrier
effects.
}
\details{
The implementations remain directly reviewable in the repository's \code{R/}
directory at \url{https://github.com/kaiyao28/TIGER-Translatable-Integrated-Genetic-Risk}.
See the repository
README and guides for input preparation and modelling decisions. The installed
quick guide is returned by
\code{system.file("doc", "getting-started.md", package = "TIGER")}. See
\code{\link{tiger_probabilities}}, \code{TIGER-high-impact}, and
\code{TIGER-plots} for the main interfaces.
}
\docType{package}
